---
import Seo from '../seo/Seo.astro';
import JsonLd from '../seo/JsonLd.astro';
import '../styles/tokens.css';
import '../styles/theme.css';
const { seo = {}, jsonLd } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <Seo {...seo}><slot name="head" /></Seo>
  <JsonLd data={jsonLd} />
</head>
<body><slot /></body>
</html>
