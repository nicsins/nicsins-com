---
import { site } from '../data/site.js';
---
<section id="contact" class="ns-wrap ns-contact-wrap"><div class="ns-contact">
  <div>
    <p class="ns-eyebrow">Contact</p>
    <h2 class="ns-h2">Make your business payable by agents.</h2>
    <p class="ns-contact__aside">If it is a real problem, write. A cooperative that needs to become a thing, a form someone cannot finish alone, or a system that is lying about itself. Minneapolis.</p>
  </div>
  <a class="ns-btn ns-btn--primary" href={`mailto:${site.email}`}>Start a project →</a>
</div></section>
