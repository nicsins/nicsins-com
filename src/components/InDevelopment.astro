---
import Section from './Section.astro';
import { inDevelopment } from '../data/content.js';
const host = (u) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---
<Section id="in-development" eyebrow="In development" title="What's next"><div class="ns-grid">
  {inDevelopment.map((p) => { const T = p.href ? 'a' : 'div'; return (
    <T class="ns-card ns-card--dev" href={p.href}><span class="ns-badge ns-badge--dev">{p.tag}</span><h3 class="ns-h3">{p.name}</h3><p>{p.desc}</p>{p.href && <div class="ns-card__meta"><span>{host(p.href)}</span><span>↗</span></div>}</T>); })}
</div></Section>
