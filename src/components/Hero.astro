---
import { site } from '../data/site.js';
---
<header class="ns-hero"><div class="ns-hero__art" style="--hero-img:url(/hero-a-network.webp)"></div><div class="ns-wrap">
  <p class="ns-eyebrow">{site.name} · agent-native infrastructure</p>
  <h1 class="ns-h1">I build agent commerce that already runs.</h1>
  <p class="ns-lead">AI agents discover a service, pay per call, and get the result. Live systems and real numbers, not slides.</p>
  <div class="ns-actions"><a class="ns-btn ns-btn--primary" href={`mailto:${site.email}`}>Start a project →</a><a class="ns-btn ns-btn--ghost" href={site.social.github}>GitHub</a><a class="ns-btn ns-btn--ghost" href={site.social.x}>X</a></div>
</div></header>
